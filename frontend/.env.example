# ─── StockVista Frontend — Environment Variables ───────────────────────────────
#
# Copy this file to .env.local and adjust as needed.
# Point this to your running backend API instance.
#
# Default local backend URL:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# For production deployments (e.g. Vercel), set to your live backend:
# NEXT_PUBLIC_API_BASE_URL=https://stockvista-7kk1.onrender.com/api
